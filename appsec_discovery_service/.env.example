POSTGRES_HOST=discovery_db
POSTGRES_DB=discovery_db
POSTGRES_USER=discovery_user
POSTGRES_PASSWORD=some_secret_str
# read-only: scopes read_api + read_repository (the service never writes to GitLab)
GITLAB_PRIVATE_TOKEN=some_secret_str
GITLAB_URL=https://gitlab.examle.com
GITLAB_PROJECTS_PREFIX=backend/,frontend/,test/
GITLAB_SCAN_TYPES=mains,mrs
PARSERS=all
UI_ADMIN_EMAIL=admin@example.com
# Required: bcrypt hash of the admin password (the plain-text UI_ADMIN_PASSWORD is refused, and so
# are well-known passwords such as admin / password), e.g.:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('<your password>'))"
# (wrap the hash in single quotes so compose does not expand its $ signs).
UI_ADMIN_PASSWORD_HASH=
# Required, at least 32 characters and not this example value: `openssl rand -hex 32`
UI_JWT_KEY=change_me_to_a_random_string_of_32_chars_or_more
# Lifetime of API / UI / MCP bearer tokens (POST /api/token), minutes. The review queue is also an
# MCP server (streamable HTTP) at http://<host>/api/mcp, with the same "Authorization: Bearer <token>".
UI_TOKEN_TTL_MINUTES=30
# MCP (API): byte cap of one tool result (lists are cut, `truncated: true` + a hint; 0 = no cap) and tool calls per
# minute per client (service token or admin; 0 = no limit). UI_BASE_URL: base of the `ui_url` deep links in MCP
# answers, e.g. https://discovery.example.com (empty: paths only).
MCP_MAX_RESPONSE_BYTES=200000
MCP_RATE_LIMIT_PER_MINUTE=600
UI_BASE_URL=
# Prompt trials (MCP llm_prompt_trial / POST /llm_rules/{id}/trials): a candidate prompt of an LLM rule is run
# with the service LLM (LLM_API_URL) on a few subjects; they cost real model calls. Subjects per trial
# (targets + controls) and model calls of all trials per UTC day (0 disables trials).
LLM_TRIAL_MAX_SUBJECTS=200
LLM_TRIAL_DAILY_CALLS=2000
# Tiered LLM workflow: the service model categorises; every service need_more_info verdict (at most
# LLM_ESCALATION_DAILY_MAX per rule a UTC day; the rest stays in the review queue and is counted as overflow) and a QA
# sample of its confident verdicts (positive and negative, per rule; LLM_QA_SAMPLE_RATE, at most LLM_QA_DAILY_MAX a
# UTC day) become verify items for a harness model (MCP llm_work_claim(purpose="verify")). A rule whose
# service/harness agreement is below LLM_QA_AGREEMENT_MIN (>= 30 samples, 30 days) is flagged "needs improvement".
# LLM_EXTERNAL_RESERVE_H: how long unclaimed external work items keep their objects from service runs.
LLM_VERIFY_ESCALATE=true
LLM_ESCALATION_DAILY_MAX=2000
LLM_QA_SAMPLE_RATE=0.05
LLM_QA_DAILY_MAX=500
LLM_QA_AGREEMENT_MIN=0.9
LLM_EXTERNAL_RESERVE_H=1
# LLM rule lifecycle: a prompt / scope edit, new core prompts or another LLM_API_MODEL make a new rule version; the
# verdicts of the old one stay (flagged stale, still scoring) until a rule rollout asks them again in budgeted slices.
# LLM_REASK_INLINE=true: every run asks them at once instead (the behaviour before). LLM_ROLLOUT_DEFAULT (API): the
# rollout of an edit - canary | staged (planned, a human starts it) | immediate (running at once).
# LLM_CORE_BUMP_MODE: canary | manual (a candidate version per rule) | immediate; LLM_MODEL_CHANGE_POLICY: rollout |
# reask | ignore. Budget of all rollouts: LLM_ROLLOUT_CALLS_PER_HOUR model calls, LLM_ROLLOUT_MAX_PARALLEL_JOBS
# slices, paused while more than LLM_ROLLOUT_FRESH_BACKLOG_MAX fresh LLM runs wait; a rollout pauses itself when the
# harness agreement on the new version (>= LLM_ROLLOUT_QA_MIN_SAMPLES QA samples) is below LLM_ROLLOUT_QA_AGREEMENT_MIN
# or more than LLM_ROLLOUT_QA_MAX_DROP below the old version's. HIT_HISTORY_DAYS: verdict history.
LLM_REASK_INLINE=false
LLM_ROLLOUT_DEFAULT=canary
LLM_CORE_BUMP_MODE=canary
LLM_MODEL_CHANGE_POLICY=rollout
LLM_ROLLOUT_TICK_S=60
LLM_ROLLOUT_CALLS_PER_HOUR=2000
LLM_ROLLOUT_MAX_PARALLEL_JOBS=1
LLM_ROLLOUT_FRESH_BACKLOG_MAX=20
LLM_ROLLOUT_SLICE_OBJECTS=200
LLM_ROLLOUT_QA_MIN_SAMPLES=20
LLM_ROLLOUT_QA_AGREEMENT_MIN=0.8
LLM_ROLLOUT_QA_MAX_DROP=0.1
HIT_HISTORY_DAYS=180
# Scanner worker pools (docs/service/jobs.md, table `jobs`): MAX_WORKERS scan worker processes (each scan clones
# into its own temporary directory, removed when the job ends; the code default is 2, this example runs 5),
# SYNC_WORKERS for the GitLab polling sync (every PROJECTS_POLL_INTERVAL_S; a project without new activity is
# re-read every SYNC_UNCHANGED_EVERY_H hours), CONTROL_WORKERS for the jobs that call no model (harness verify
# items, answers of external runs, rollouts, relabel, statistics, cleanup) and LLM_WORKERS for the service LLM
# rule runs, each with LLM_CONCURRENCY model calls in flight; LLM_RATE_PER_MIN caps the model calls per minute of
# all workers together (0 = no limit; set it to your provider's quota).
# A failed job is retried after JOB_BACKOFF_BASE_S * 2^(attempt-1) s (max JOB_BACKOFF_MAX_S) up to
# JOB_MAX_ATTEMPTS times; a job whose worker died is re-run after JOB_LEASE_S; idle workers poll every JOB_POLL_S.
# (CACHE_SIZE_GB is no longer used.)
MAX_WORKERS=5
SYNC_WORKERS=2
CONTROL_WORKERS=1
LLM_WORKERS=1
LLM_CONCURRENCY=2
LLM_RATE_PER_MIN=0
PROJECTS_POLL_INTERVAL_S=300
SYNC_UNCHANGED_EVERY_H=24
# GitLab API: in-memory cache of reads per worker process (0 disables), request timeout, git clone timeout;
# WORKSPACE_DIR: parent of the per-job checkout directories (empty = /workspace, the volume SCAN_WORKSPACE_VOLUME;
# set SCAN_WORKSPACE_VOLUME to a host directory on another disk to keep clones off the Postgres disk).
# No clone starts with less than WORKSPACE_MIN_FREE_GB free there (0 = no check); repositories GitLab reports larger
# than SCAN_MAX_REPO_MB are not cloned (0 = no limit); GIT_PARTIAL_CLONE: MR sources with history as --filter=blob:none
GITLAB_CACHE_TTL_S=300
GITLAB_TIMEOUT_S=30
GIT_TIMEOUT_S=1800
WORKSPACE_DIR=
SCAN_WORKSPACE_VOLUME=scan_workspace
WORKSPACE_MIN_FREE_GB=5
SCAN_MAX_REPO_MB=0
GIT_PARTIAL_CLONE=true
# recount of stale LLM coverage rows (GET /llm_progress) by a control worker every N seconds; 0 disables
LLM_COVERAGE_INTERVAL_S=300
# statistics snapshots (overview, job health, scan / LLM progress, LLM quality, hits aggregate) recomputed by a
# control worker every N seconds and served by the API while fresh; 0 disables (the API computes live)
STATS_REFRESH_S=60
JOB_LEASE_S=300
JOB_POLL_S=5
JOB_MAX_ATTEMPTS=5
JOB_BACKOFF_BASE_S=30
JOB_BACKOFF_MAX_S=3600
JOBS_RETENTION_DAYS=7
# SIGTERM: running jobs are requeued at their next safe point; workers still busy after this are killed
# (keep docker-compose's stop_grace_period, 180s, above it)
SHUTDOWN_TIMEOUT_S=150
# Host port of nginx, the only published port (Postgres / API / LLM stay on internal networks)
HTTP_PORT=80
# LLM rule: any OpenAI-compatible endpoint. Default (unset): the bundled llama.cpp server
# http://discovery_llm:8080/v1. Empty value disables the LLM rule. External API example:
#   LLM_API_URL=https://api.deepseek.com  LLM_API_KEY=sk-...  LLM_API_MODEL=deepseek-chat
# (LLM_LOCAL_MODEL / LLM_LOCAL_FILE were removed: local models run in discovery_llm.)
#LLM_API_URL=http://discovery_llm:8080/v1
LLM_API_KEY=
LLM_API_MODEL=local-model
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=8192
# response_format for structured answers: auto | json_schema | json_object | none
LLM_STRUCTURED=auto
# Model of the bundled discovery_llm server: Hugging Face "<repo>[:quant]" (downloaded once into
# the llm_cache volume), or a GGUF file in LLM_MODELS_DIR: LLM_MODEL_FILE=/models/<file>.gguf + LLM_HF_REPO=
LLM_HF_REPO=Qwen/Qwen2.5-3B-Instruct-GGUF:Q4_K_M
LLM_MODEL_FILE=
LLM_MODELS_DIR=./llm_models
LLM_CTX_SIZE=8192
LLM_PARALLEL=2
# (LLM_PROMPT / LLM_PROMPT_VER are gone: LLM rules are made in the UI / REST / MCP; an LLM field rule without
# category is the built-in classifier)
# Languages (as detected for the project) whose cloned mains/MRs are scanned, csv; "all" disables the gate (was hard-coded "go").
SCAN_LANGS=all
# Diff-based scan skip: before cloning a main branch (or an MR) the scanner asks the GitLab compare API which files
# changed since the commit its snapshot reflects; when no parser of the scan reads any of them the snapshot is moved
# to the new commit without a clone, a parse or an LLM run (the job ends "skipped: no parser files changed").
# SCAN_DIFF_SKIP=false: every commit is cloned and parsed (the behaviour before). A full scan happens anyway every
# SCAN_FULL_RESCAN_DAYS days (0 = never on time alone), when the compare lists SCAN_DIFF_MAX_FILES files or more,
# after a force push / rebase, a scanner upgrade or a keyword rule edit, and when a changed file matches
# SCAN_ALWAYS_RESCAN_GLOBS (comma separated globs, e.g. "Makefile,config/*.toml"; empty = none).
SCAN_DIFF_SKIP=true
SCAN_DIFF_SKIP_MRS=true
SCAN_FULL_RESCAN_DAYS=7
SCAN_DIFF_MAX_FILES=1000
SCAN_ALWAYS_RESCAN_GLOBS=
# Retention / GC of the scanner DB (optional, defaults shown)
MR_STALE_DAYS=30
MR_ROW_RETENTION_DAYS=7
GC_INTERVAL_HOURS=24
GC_BATCH_SIZE=5000
HITS_PENDING_ORPHAN_DAYS=14
# hits without a live subject: match / need_more_info (DECIDED), no_match (REJECTED: the name predates
# the status rename confirmed/rejected -> match/no_match, migration 0023)
HITS_DECIDED_UNSEEN_DAYS=180
HITS_REJECTED_UNSEEN_DAYS=365
SCANS_KEEP_PER_BRANCH=20
# harness verifications (llm_verifications) and finished prompt trials are deleted after this many days; 0 keeps them
LLM_VERIFICATIONS_RETENTION_DAYS=365
PROMPT_TRIALS_RETENTION_DAYS=90
# Docker log rotation of every container (json-file driver): size per file and files kept
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5
